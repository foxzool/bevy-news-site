---
import type { Listing } from '../lib/content';
import { formatDate, shanghaiDate } from '../lib/site';

interface Props {
  items: Listing[];
  heading?: 'h2' | 'h3';
  empty?: string;
}

const { items, heading = 'h2', empty = '这一栏还没有文章。' } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ol class="entries">
      {items.map((item) => (
        <li>
          <article class="entry">
            <time datetime={shanghaiDate(item.date)}>{formatDate(item.date)}</time>
            {heading === 'h2' ? (
              <h2>
                <a href={item.href}>{item.title}</a>
              </h2>
            ) : (
              <h3>
                <a href={item.href}>{item.title}</a>
              </h3>
            )}
            <p>{item.summary}</p>
            <ul class="tags">
              {item.quietDay && <li><span class="quiet">无合并</span></li>}
              {item.tags.map((tag) => (
                <li>
                  <a href={`/zh/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  )
}

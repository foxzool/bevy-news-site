  <p class="lede">
    每周精选。内容写入 <code>src/content/gamedev/zh/</code>。<a href="/zh/gamedev/rss.xml">订阅本栏目</a>
  </p>
  <EntryList items={entries} empty="还没有游戏开发周报。" />
</Base>

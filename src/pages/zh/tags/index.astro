---
import Base from '../../../layouts/Base.astro';
import { allPublished } from '../../../lib/content';

const counts = new Map<string, number>();
for (const entry of await allPublished('zh')) {
  for (const tag of entry.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'));
---

<Base title="标签" description="按标签浏览狐闻。" path="/zh/tags/">
  <h1>标签</h1>
  {
    tags.length === 0 ? (
      <p class="empty">还没有标签。</p>
    ) : (
      <ul class="tags">
        {tags.map(([tag, count]) => (
          <li>
            <a href={`/zh/tags/${encodeURIComponent(tag)}/`}>
              {tag} ({count})
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
